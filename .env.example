# Copy to .env and fill in. .env is ignored by git.

# demo | clinical
DC_MODE=demo
DC_BIND=127.0.0.1:8080
DC_DATA_DIR=data

# Address browsers use to reach the app. Must be https:// for clinical mode
# on the network (put a TLS proxy in front until built-in TLS lands in M9).
# DC_PUBLIC_ORIGIN=https://dentalclarity.practice.lan
# Reverse proxies allowed to set the client address: one address or a
# comma-separated list of CIDR ranges, such as "fdaa::/16, 172.16.0.0/12".
# DC_TRUSTED_PROXY=127.0.0.1
# Header a trusted proxy puts the client address in, such as fly-client-ip.
# Requires DC_TRUSTED_PROXY. Without it, the rightmost X-Forwarded-For entry is used.
# DC_CLIENT_IP_HEADER=
# Send HSTS. Only with a certificate every device trusts.
# DC_HSTS=false

# Demo mode only. Used for synthetic data; never for real patient records.
OPENROUTER_API_KEY=
# Monthly spend cap for the public demo in US dollars. New generations stop at 80%.
# DC_DEMO_MONTHLY_BUDGET_USD=25

# Optional overrides of the app-managed model defaults (see docs/DECISIONS.md D4).
# DC_TEXT_MODEL=
# DC_SPEECH_MODEL=
# DC_SPEECH_VOICE=

# Practice management connector: synthetic (default) or opendental.
# opendental works in clinical mode only. See docs/OPENDENTAL.md.
# DC_PMS=synthetic
# DC_OPENDENTAL_HOST=127.0.0.1
# DC_OPENDENTAL_PORT=3306
# DC_OPENDENTAL_DATABASE=opendental
# DC_OPENDENTAL_USER=dentalclarity_ro
# DC_OPENDENTAL_PASSWORD=
# preferred on this machine; required, verify-ca or verify-identity for another host.
# DC_OPENDENTAL_TLS=
# DC_OPENDENTAL_TLS_CA=
# Shown until a practice name is saved in Settings.
# DC_PRACTICE_NAME=

# Paths, relative to the working directory.
# DC_FIXTURE=fixtures/synthetic/practice.toml
# DC_KNOWLEDGE_DIR=knowledge
