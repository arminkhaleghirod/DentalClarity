# DentalClarity service settings. The service reads this file at start.
# Restart the service after a change: sc.exe stop DentalClarity, then sc.exe start DentalClarity.
# Do not put secrets here. Store them with: dentalclarity.exe secret set NAME

DC_MODE=clinical

# Listen on every interface on port 8443. The installer's firewall rule
# allows this port from the local subnet only.
DC_BIND=0.0.0.0:8443

# The address workstations and tablets use. Required: the server checks it
# on every change request. Use a name or a fixed IP address on the LAN.
DC_PUBLIC_ORIGIN=https://dentalclarity.practice.lan:8443

# TLS. local-ca makes a certificate authority on first start and exports
# %ProgramData%\DentalClarity\data\tls\dentalclarity-ca.crt, which every
# device must trust (see WINDOWS-README.md). For a certificate from the
# practice's IT, set DC_TLS_CERT and DC_TLS_KEY to PEM files instead.
DC_TLS=local-ca
# Extra names or addresses for the certificate, comma-separated. The host
# of DC_PUBLIC_ORIGIN is always included.
# DC_TLS_HOSTNAMES=192.168.1.20
# DC_TLS_CERT=C:\ProgramData\DentalClarity\tls\server.crt
# DC_TLS_KEY=C:\ProgramData\DentalClarity\tls\server.key
# Only with a certificate every device trusts.
# DC_HSTS=false

# AI provider: the practice's own AWS account (Bedrock and Polly).
# Without it, presentations cannot be generated.
# DC_AI_PROVIDER=aws
# DC_AWS_REGION=us-west-2
# DC_BEDROCK_TEXT_MODEL=anthropic.claude-haiku-5-5
# DC_BEDROCK_REVIEWER_MODEL=
# DC_POLLY_ENGINE=neural
# DC_POLLY_VOICE=Joanna
